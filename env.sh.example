# env.sh.example -- copy to env.sh and edit for your machine. `env.sh` is gitignored.
# UpgradeBench accepts machine-specific data and dependency locations through
# environment variables; no source edit is required.

# Repository root, resolved from this file by default.
export VCU_ROOT="${VCU_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)}"

# Python interpreter from an environment built with requirements/requirements.txt.
export PYTHON="${PYTHON:-python}"

# External NBFNet-PyG checkout for graph-reference reproduction.
# See requirements/nbfnet-setup.md for the source-locked revision.
export NBFNET_PATH="${NBFNET_PATH:-$VCU_ROOT/third_party/NBFNet-PyG}"

# Private source archives; see requirements/DATA.md. These are never committed.
export VCU_RAW="${VCU_RAW:-$VCU_ROOT/data/raw}"

# Optional strict filtered BACI cache built by tools/build_baci_filtered_cache.py.
export VCU_BACI_CACHE="${VCU_BACI_CACHE:-$VCU_ROOT/private/baci_cache_strict}"

# GPU/CUDA is needed only for NBFNet reproduction. Uncomment and adapt to the
# host; CPU cohort and audit commands do not require this block.
# source /etc/profile.d/modules.sh
# module load cuda/12.6 gcc/gcc-12 2>/dev/null
# export CUDA_HOME=/usr/local/cuda-12.6
# export PATH="$CUDA_HOME/bin:$PATH"
# export TORCH_CUDA_ARCH_LIST="8.9"
